# Bu dosyayı .env.local olarak kopyalayın (yerel geliştirme için).
# Canlı ortam: Vercel → Project Settings → Environment Variables

# ═══ SEÇENEK 1: Resend (ÖNERİLEN) ═══════════════════════════════════════════
# Microsoft 365'ten bağımsız çalışır. Kiracıda SMTP AUTH kapalı olsa bile
# e-posta gider. RESEND_API_KEY tanımlıysa bu yol kullanılır.
RESEND_API_KEY=

# Gönderen adresi. Resend'de DOĞRULANMIŞ alan adına ait olmak ZORUNDA.
# Alıcının doğrulanmasına gerek yok — sadece gönderen alan adı doğrulanır.
MAIL_FROM=Zekeriyaköy Fen Bilimleri <bilgi@zekeriyakoyfenbilimleri.com>

# ═══ SEÇENEK 2: SMTP (yedek) ════════════════════════════════════════════════
# RESEND_API_KEY boşsa bu kullanılır. Microsoft 365 kiracısında
# "Authenticated SMTP" açık olmalı, aksi halde 535 5.7.139 hatası alınır.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=alim.demirli@abdkurumlari.com
SMTP_PASS=

# ═══ ORTAK ══════════════════════════════════════════════════════════════════
# Sitedeki TÜM formlar bu kutuya düşer.
MAIL_TO=alim.demirli@abdkurumlari.com
