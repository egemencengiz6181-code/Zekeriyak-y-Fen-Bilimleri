# Bu dosyayı .env.local olarak kopyalayın (yerel geliştirme için).
# Canlı ortam: Vercel → Project Settings → Environment Variables

# ─── E-posta / İletişim formları (Microsoft 365) ─────────────────────────────
# Sitedeki TÜM formlar /api/contact üzerinden bu kutuya düşer.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=alim.demirli@abdkurumlari.com

# ZORUNLU. Microsoft 365 hesabında MFA açıksa normal parola ÇALIŞMAZ —
# uygulama parolası (app password) oluşturup buraya yazın.
SMTP_PASS=

# Formların düşeceği adres. Boş bırakılırsa SMTP_USER kullanılır.
MAIL_TO=alim.demirli@abdkurumlari.com

# NOT: Gönderen (From) adresi her zaman SMTP_USER olur. Microsoft 365,
# From başlığı oturum açan kutudan farklıysa gönderimi reddeder
# ("5.7.60 Client does not have permissions to send as this sender").
